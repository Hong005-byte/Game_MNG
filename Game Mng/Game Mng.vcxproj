      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <!-- vcpkg's own MSBuild integration injects this include path at actual
           build time, but IntelliSense doesn't always pick up that dynamic
           injection (seen as false "cannot open SFML/Graphics.hpp" squiggles
           even though the real compiler resolves it fine), so it's declared
           here explicitly too, letting IntelliSense see the same path the compiler uses. -->
      <AdditionalIncludeDirectories>$(ProjectDir)vcpkg_installed\x64-windows\x64-windows\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <!-- Same story as AdditionalIncludeDirectories above, but for the link
           step: vcpkg's dynamic injection normally adds /LIBPATH and a
           lib\*.lib wildcard (link.exe expands the glob itself), but under
           this VS/.slnx combination that injection doesn't happen for Link
           the way it does for ClCompile, so every SFML symbol comes back
           unresolved. Declaring it here removes the dependency on that
           dynamic step working at all. -->
      <AdditionalLibraryDirectories>$(ProjectDir)vcpkg_installed\x64-windows\x64-windows\debug\lib;$(ProjectDir)vcpkg_installed\x64-windows\x64-windows\debug\lib\manual-link;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>$(ProjectDir)vcpkg_installed\x64-windows\x64-windows\debug\lib\*.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <Manifest>
      <EnableSegmentHeap>true</EnableSegmentHeap>
    </Manifest>
    <PostBuildEvent>
      <!-- vcpkg's own "AppLocalFromInstalled" step normally copies these
           runtime DLLs next to the exe after a build; it's part of the same
           dynamic injection that isn't running under this VS/.slnx
           combination (see the Link comment above), so without this the exe
           links fine but fails at launch with "X.dll was not found". -->
      <Command>xcopy /Y /D /I "$(ProjectDir)vcpkg_installed\x64-windows\x64-windows\debug\bin\*.dll" "$(OutDir)"</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
